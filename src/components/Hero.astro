---
/**
 * Calcula los años pasados desde una fecha de inicio hasta hoy, con redondeo
 * @param startDate - Fecha de inicio (puede ser string, Date o timestamp)
 * @returns Número de años redondeado (ej: 2.5 años -> 3, 2.4 años -> 2)
 */
function calculateYearsPassed(startDate: Date | string | number): number {
  // Convertir a Date si es necesario
  const start = new Date(startDate);
  const now = new Date();

  // Calcular diferencia en milisegundos
  const diffMs = now.getTime() - start.getTime();

  // Diferencia en años (considerando año promedio de 365.25 días)
  const yearsDiff = diffMs / (1000 * 60 * 60 * 24 * 365.25);

  // Redondear: si es >= 0.5 (6 meses) redondea hacia arriba, sino hacia abajo
  return Math.round(yearsDiff);
}
