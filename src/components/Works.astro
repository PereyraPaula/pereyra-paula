---
import { months, type DesarrolloFrontmatter } from "../content.config";
import Section from "./Section.astro";

const markdowns: any = Object.values(
  import.meta.glob("../pages/desarrollo/*.md", { eager: true }),
);

const convertirFechas = (fechaStr: string): number => {
    if (!fechaStr) return 0;
    // Transforma "Abril - 2025" a ["abril", "2025"]
    const [mes, año] = fechaStr
        .toLowerCase()
        .split("-")
        .map((s) => s.trim());
    const mesIngles = months[mes] || mes;
    return Date.parse(`${mesIngles} 1, ${año}`) || 0;
};

const trabajos: DesarrolloFrontmatter[] = markdowns
    .filter((works: any) => !works.frontmatter.archived)
    .map((el: any) => {
        return { ...el.frontmatter, url: el.url };
    })
    .sort(
        (a: { fecha: string }, b: { fecha: string }) =>
            convertirFechas(b.fecha) - convertirFechas(a.fecha),
    );

const techs: { [key: string]: string } = {
    wordpress: `
        <svg
            class="w-10 h-10"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            title="Hecho con Wordpress"
        ><path
            fill="currentColor"
            fill-rule="evenodd"
            d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2m0 19.542c-5.261 0-9.541-4.281-9.541-9.542S6.739 2.458 12 2.458s9.542 4.28 9.542 9.542c0 5.26-4.28 9.542-9.542 9.542M3.422 12a8.58 8.58 0 0 0 4.835 7.72L4.164 8.51A8.55 8.55 0 0 0 3.422 12m14.37-.432c0-1.06-.382-1.794-.708-2.366-.435-.707-.843-1.305-.843-2.012 0-.788.598-1.522 1.44-1.522q.058.001.112.007A8.55 8.55 0 0 0 12 3.42a8.57 8.57 0 0 0-7.168 3.867c.202.006.392.01.553.01.897 0 2.286-.109 2.286-.109.462-.027.517.652.055.707 0 0-.465.055-.982.082l3.124 9.292 1.877-5.63-1.336-3.662c-.462-.027-.9-.082-.9-.082-.462-.027-.408-.734.055-.707 0 0 1.416.11 2.259.11.897 0 2.286-.11 2.286-.11.463-.027.517.652.055.707 0 0-.465.055-.982.082l3.1 9.221.857-2.859c.37-1.187.652-2.039.652-2.773m-5.64 1.183-2.574 7.48a8.57 8.57 0 0 0 5.272-.137 1 1 0 0 1-.062-.119zm7.377-4.866q.057.41.058.882c0 .87-.163 1.849-.653 3.073l-2.62 7.576A8.57 8.57 0 0 0 20.578 12a8.54 8.54 0 0 0-1.05-4.116"
        ></path>
        </svg>
    `,
    flutter: `
        <svg
            class="w-10 h-10 grayscale hover:grayscale-50"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 128 128"
            ><path
                fill="#3fb6d3"
                d="M12.3 64.2 76.3 0h39.4L32.1 83.6zm64 63.8h39.4L81.6 93.9l34.1-34.8H76.3L42.2 93.5z"
            ></path><path
                fill="#27aacd"
                d="m81.6 93.9-20-20-19.4 19.6 19.4 19.6z"></path><path
                fill="#19599a"
                d="M115.7 128 81.6 93.9l-20 19.2L76.3 128z"
            ></path><linearGradient
                id="SVGzU71EysQ"
                x1="59.365"
                x2="86.825"
                y1="116.36"
                y2="99.399"
                gradientUnits="userSpaceOnUse"
            ><stop offset="0" stop-color="#1b4e94"></stop><stop
                offset=".63"
                stop-color="#1a5497"></stop><stop
                offset="1"
                stop-color="#195a9b"></stop></linearGradient
            ><path
                fill="url(#SVGzU71EysQ)"
                d="m61.6 113.1 30.8-8.4-10.8-10.8z"></path>
        </svg>
    `,
};
---

<Section id="trabajos" classes="bg-gray-100">
    <div class="container py-24 px-10 mx-auto my-15">
        <h1
            class="title-font sm:text-4xl text-3xl mb-15 font-medium text-gray-900 text-center"
        >
          Algunos de mis trabajos
        </h1>
        <div
            class="grid lg:grid-col-4 md:grid-cols-3 grid-cols-1 gap-4 flex-row -m-4"
        >
            {
                trabajos.map((trabajo: DesarrolloFrontmatter) => (
                    <article class="h-full border-2 border-gray-200 border-opacity-60 rounded-lg overflow-hidden bg-white">
                        <div class="lg:h-48 md:h-36 w-full overflow-hidden relative">
                            <div
                                class="w-full h-full bg-cover bg-top transition-[background-position] duration-[2s] ease-out delay-500
                               hover:bg-bottom hover:duration-[4s] hover:delay-0"
                                style={{
                                    backgroundImage: `url(${trabajo.imagen})`,
                                }}
                            />
                            {trabajo.tecnologia_principal && (
                                <div
                                    class="absolute top-2 right-2 text-gray-500 hover:text-gray-200"
                                    set:html={
                                        techs[
                                            trabajo.tecnologia_principal.toLowerCase()
                                        ]
                                    }
                                />
                            )}
                        </div>
                        <div class="p-6">
                            <h1 class="title-font text-lg font-medium text-gray-900 mb-3">
                                {trabajo.titulo}
                            </h1>
                            <p class="leading-relaxed mb-3">
                                {trabajo.descripcion}
                            </p>
                            <div class="flex justify-between items-center flex-wrap">
                                <a
                                    target="_blank"
                                    class="text-primary underline inline-flex items-center md:mb-2 lg:mb-0 mr-3"
                                    href={trabajo.enlace ?? trabajo.repositorio}
                                >
                                    {trabajo.enlace
                                        ? "Ver sitio"
                                        : "Ver repositorio"}
                                </a>
                                <a
                                    href={trabajo.url}
                                    class="text-primary inline-flex items-center md:mb-2 lg:mb-0"
                                >
                                    Mas detalles
                                    <svg
                                        class="w-4 h-4 ml-2 my-0 py-0"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        fill="none"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M5 12h14" />
                                        <path d="M12 5l7 7-7 7" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</Section>
